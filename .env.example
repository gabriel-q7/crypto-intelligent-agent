# Modelo servido pelo Ollama. Usado tanto para baixar (ollama-pull) quanto pela aplicação.
# Pode ser sobrescrito por execução, sem editar este arquivo:
#   OLLAMA_MODEL=gemma4:e4b docker compose run --rm app
# Padrão: gemma4:e2b (melhor resultado no benchmark; ver docs/stage-1-evidence.md, seção 9).
# Modelos avaliados: gemma4:e2b, qwen2.5:7b, gemma4:e4b, mistral:7b
OLLAMA_MODEL=gemma4:e2b
# Dentro do Docker Compose a aplicação acessa o Ollama pelo nome do serviço.
# Para rodar a aplicação fora do Docker, use http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
# 0 = saída mais determinística, adequada para JSON estruturado
OLLAMA_TEMPERATURE=0
# Timeout (segundos) por requisição ao Ollama. Em CPU, modelos maiores podem precisar de mais.
OLLAMA_REQUEST_TIMEOUT=300
# Raciocínio interno ("thinking") em modelos que suportam (ex.: gemma4).
# false (padrão) = desliga; true = liga; vazio = padrão do modelo.
# No benchmark, thinking ligado aumentou a latência em ~42% sem ganho de acurácia.
OLLAMA_REASONING=false
# Porta publicada no host para o Ollama
OLLAMA_HOST_PORT=11434

# Janela de contexto do modelo. O padrão do Ollama (4096) trunca o prompt do agente ReAct.
OLLAMA_NUM_CTX=8192

# --- Fase 2: CoinPaprika (https://api.coinpaprika.com/) ---
# Plano gratuito não exige chave. Com chave paga, use a URL api-pro e preencha a chave.
COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
COINPAPRIKA_API_KEY=
COINPAPRIKA_TIMEOUT=15
COINPAPRIKA_MAX_RETRIES=2
# Espera máxima (s) aceitável por Retry-After antes de desistir
COINPAPRIKA_MAX_RETRY_WAIT=10

# --- Fase 2: agente ---
AGENT_MAX_ITERATIONS=6
AGENT_MAX_EXECUTION_TIME=600
# Memória de curto prazo limitada (turnos e caracteres renderizados no prompt)
MEMORY_MAX_TURNS=4
MEMORY_MAX_CHARS=3000

# --- Fase 2: base de conhecimento (Chroma, modo embutido persistente) ---
EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_CORPUS_DIR=knowledge/corpus
VECTOR_STORE_DIR=data/chroma
KNOWLEDGE_COLLECTION=crypto_knowledge
KNOWLEDGE_TOP_K=3

LOG_LEVEL=INFO
# Porta publicada no host para a API (http://localhost:8000/docs)
APP_HOST_PORT=8000
